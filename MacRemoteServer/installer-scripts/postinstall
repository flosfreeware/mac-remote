#!/bin/zsh
# Package Installer runs as root. Launch the installed app in the active
# graphical user's session so its own first-run setup can request Accessibility
# permission and present the pairing QR code.
set -euo pipefail

console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" ]]; then
  exit 0
fi

uid="$(/usr/bin/id -u "$console_user")"
# The same bundle identifier may already be running from a development build
# or the previous installed build. Its in-memory pairing state survives data
# cleanup, so stop it before launching the newly installed copy.
/bin/launchctl asuser "$uid" /usr/bin/pkill -U "$uid" -x MacRemoteServer >/dev/null 2>&1 || true
for attempt in {1..50}; do
  if ! /usr/bin/pgrep -U "$uid" -x MacRemoteServer >/dev/null 2>&1; then break; fi
  /bin/sleep 0.1
done
/bin/launchctl asuser "$uid" /usr/bin/open -n "/Applications/Mac Remote.app" || true
